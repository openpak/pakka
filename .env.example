# Pakka environment template. Copy to .env (git-ignored) and fill in secrets.
# Plain environment variables take precedence over .env.
PAKKA_ADDR=127.0.0.1:24800
PAKKA_DNS_HOST=localhost
PAKKA_TCP_ADDR=
PAKKA_HEALTH_URL=
PAKKA_CHECK_TIMEOUT=5s
PAKKA_MAX_RUNS=4
# Meta Model API (https://api.meta.ai/v1). Required for live investigations.
PAKKA_META_API_KEY=
PAKKA_META_API_BASE=https://api.meta.ai/v1
PAKKA_META_MODEL=muse-spark-1.3-contributor
PAKKA_INVESTIGATE_STEPS=5
