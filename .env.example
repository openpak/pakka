# Pakka environment template. Copy to .env (git-ignored) and fill in secrets.
# Plain environment variables take precedence over .env.
PAKKA_ADDR=127.0.0.1:24800
PAKKA_DNS_HOST=localhost
PAKKA_TCP_ADDR=
PAKKA_HEALTH_URL=
PAKKA_CHECK_TIMEOUT=5s
PAKKA_MAX_RUNS=4
# Meta Model API (https://api.meta.ai/v1). Required for live investigations.
PAKKA_META_API_KEY=
PAKKA_META_API_BASE=https://api.meta.ai/v1
PAKKA_META_MODEL=muse-spark-1.3-contributor
PAKKA_INVESTIGATE_STEPS=5
# Discord bot (https://discord.com/developers/applications). Needs the Message Content intent.
PAKKA_DISCORD_TOKEN=
#PAKKA_DISCORD_GUILDS=
#PAKKA_DISCORD_PREFIX=!pakka
# Command channels (IDs, comma-separated, empty = everywhere the bot can read).
#PAKKA_DISCORD_CHANNELS=
# Ops channels where !pakka investigate works (empty = unrestricted).
#PAKKA_DISCORD_OPS_CHANNELS=
# Status channel for automatic outage alerts (empty = monitor disabled).
#PAKKA_DISCORD_STATUS_CHANNEL=
#PAKKA_STATUS_INTERVAL=60s
#PAKKA_STATUS_TARGETS=Website=https://openpak.org/,Accounts=https://account.openpak.org/healthz
# Welcome channel for newcomer greets every interval (empty = welcomer disabled).
#PAKKA_DISCORD_WELCOME_CHANNEL=
#PAKKA_DISCORD_WELCOME_INTERVAL=15m
# Support routing: intent detection redirects out-of-scope questions (all three or disabled).
#PAKKA_DISCORD_SETUP_CHANNEL=
#PAKKA_DISCORD_CONNECTION_CHANNEL=
#PAKKA_DISCORD_BUG_CHANNEL=
